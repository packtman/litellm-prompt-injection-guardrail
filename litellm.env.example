# LiteLLM proxy environment variables
# Copy this to litellm.env and fill in your actual values (litellm.env is gitignored)

LITELLM_MASTER_KEY=sk-your-litellm-master-key
UI_USERNAME=admin
UI_PASSWORD=your-secure-password
DATABASE_URL=postgresql://user@localhost:5432/litellm
STORE_MODEL_IN_DB=True

FIREWORKS_API_KEY=fw-your-fireworks-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Optional: override the judge escalation model and base URL
# JUDGE_ESCALATION_MODEL=claude-sonnet-5
# JUDGE_BASE_URL=https://api.anthropic.com
